# ── Banco de dados (Railway PostgreSQL) ──────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/dbname
# DATABASE_PUBLIC_URL=  # alternativa pública do Railway

# ── Servidor ─────────────────────────────────────────────────────
PORT=5500
SERVER_URL=https://seu-app.up.railway.app

# ── Segurança (OBRIGATÓRIO em produção) ──────────────────────────
# Token secreto para proteger rotas de administrador.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_API_TOKEN=troque-por-um-token-secreto-forte

# ── E-mail via Resend (preferido no Railway) ─────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
FROM_EMAIL=noreply@seudominio.com.br
FROM_NAME=AXIS Consultoria

# ── E-mail via Gmail SMTP (alternativa local) ────────────────────
# GMAIL_USER=seuemail@gmail.com
# GMAIL_PASS=senha-de-app-do-gmail  # NÃO use a senha normal — use App Password
